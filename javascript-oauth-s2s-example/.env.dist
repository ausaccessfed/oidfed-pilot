TRUST_ANCHOR_ENTITY_ID=https://ta.s2s.dev.localhost:8443
INGESTER_ENTITY_ID=https://ingester.s2s.dev.localhost:8443
SENDER_ENTITY_ID=https://sender.s2s.dev.localhost:8443
INGESTER_PORT=4101
SENDER_PORT=4102
DEV_MOCK_AUTH=true
# Set DEV_MOCK_AUTH=false to use real federation membership.
# Configure either a single Trust Anchor:
# TRUST_ANCHOR_ENTITY_ID=https://ta.example.org
# TRUST_ANCHOR_JWKS={"keys":[{"kty":"EC","crv":"P-256","alg":"ES256","use":"sig","kid":"...","x":"...","y":"..."}]}
# Or a JSON array of Trust Anchors:
# TRUST_ANCHORS_JSON=[{"entityId":"https://ta.example.org","jwks":{"keys":[...]}}]
