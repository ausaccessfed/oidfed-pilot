APP_ORIGIN=https://sp.dev.localhost
PORT=3000
OIDFED_CONFIG_FILE=config.json
AAF_INTERMEDIATE_ENTITY_ID=https://ta.dev.aaf.edu.au
AAF_LIST_ENDPOINT=https://ta.dev.aaf.edu.au/list
# FEDERATION_LIST_ENDPOINT=https://ta.dev.aaf.edu.au/list
ORGANIZATION_NAME=Federation Sign-in Demo
ENTITY_DISPLAY_NAME=Federation Sign-in Demo
OIDC_CLIENT_NAME=Federation Sign-in Demo
OIDC_SCOPE=openid profile email
# Override the federation trust anchors used for chain validation.
# TRUST_ANCHOR_ENTITY_ID=https://ta.oidf-pilot.edugain.org
# TRUST_ANCHOR_JWKS={"keys":[{"kty":"EC","crv":"P-256","alg":"ES256","use":"sig","kid":"...","x":"...","y":"..."}]}
# Or provide the full trust anchor set as JSON:
# TRUST_ANCHORS_JSON=[{"entityId":"https://ta.example.org","jwks":{"keys":[...]}}]
# Optional JSON override of config.json's providerMetadataPolicy.
# PROVIDER_METADATA_POLICY={"openid_provider":{"issuer":{"essential":true}}}
# Set both to enable the development-only mock sign-in.
# NODE_ENV=development
# DEV_MOCK_AUTH=true
